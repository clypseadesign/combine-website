  << /K [ 1680 0 R ]
     /P 1786 0 R
     /S /P
     /Pg 1650 0 R
     /Type /StructElem
  >>
endobj

1682 0 obj
  << /ActualText (We serve people of all backgrounds without discrimination\054 crossing boundaries of religion\054 culture\054 and nationality\056 Alongside humanitarian assistance\054 we work to address the root causes of suffering by promoting moral values\054 personal responsibility\054 and love for humanity\056 God Cares Ministries exists not for profit or recognition\054 but to serve with humility\054 integrity\054 and love\056)
     /K [ 16 ]
     /P 1683 0 R
     /Pg 1650 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

