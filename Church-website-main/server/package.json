    "@google-cloud/storage": "^7.7.0",
    "@google-cloud/logging": "^11.0.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
